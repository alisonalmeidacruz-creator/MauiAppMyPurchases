<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMyPurchases.Views.ListaProduto"
             Title="Minhas Compras"
             Shell.NavBarIsVisible="False">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Clicked_1" />
        <ToolbarItem Text="Adicionar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Primary}" Offset="0" />
            <GradientStop Color="{StaticResource Secondary}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <ResourceDictionary>

            <Style TargetType="Label">
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="cabecalho_listview" TargetType="Grid">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource Gray100},
                                            Dark={StaticResource Primary}}" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <StackLayout>

        <Grid BackgroundColor="{StaticResource Primary}"
              Padding="18"
              RowDefinitions="Auto">

            <Label Text="Minhas Compras"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />

        </Grid>

        <!-- Pesquisa por descrição -->
        <Frame Margin="12,12,12,0"
               Padding="6"
               CornerRadius="20"
               HasShadow="True"
               BackgroundColor="{StaticResource Secondary}"
               BorderColor="{StaticResource Primary}">

            <Grid>

                <SearchBar x:Name="txt_search"
                           Placeholder="Busca de Produtos"
                           TextChanged="txt_search_TextChanged"
                           BackgroundColor="Transparent"
                           PlaceholderColor="{StaticResource Gray600}"
                           TextColor="{StaticResource Gray900}" />

                <Label Text="🔍"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       Margin="0,0,8,0" />

            </Grid>

        </Frame>

        <!-- Filtro por categoria -->
        <Picker x:Name="picker_categoria"
                Title="Filtrar por categoria"
                SelectedIndexChanged="picker_categoria_SelectedIndexChanged"
                Margin="12,5,12,0"
                BackgroundColor="{StaticResource Secondary}">

            <Picker.Items>
                <x:String>Todas</x:String>
                <x:String>Alimentos</x:String>
                <x:String>Higiene</x:String>
                <x:String>Limpeza</x:String>
            </Picker.Items>

        </Picker>

        <!-- Lista de produtos -->
        <Frame Padding="0"
               Margin="10"
               VerticalOptions="FillAndExpand"
               CornerRadius="20"
               HasShadow="True"
               BackgroundColor="Transparent"
               BorderColor="{StaticResource Primary}"
               IsClippedToBounds="False">

            <ListView x:Name="lst_produtos"
                      IsPullToRefreshEnabled="True"
                      Refreshing="lst_produtos_Refreshing"
                      ItemSelected="lst_produtos_ItemSelected">

                <ListView.Header>

                    <Grid ColumnDefinitions="30, 100, 80, 50, 90"
                          Style="{StaticResource Key=cabecalho_listview}">

                        <Label Grid.Column="0"
                               Text="ID"
                               Padding="5"
                               FontAttributes="Bold" />

                        <Label Grid.Column="1"
                               Text="Descrição"
                               FontAttributes="Bold" />

                        <Label Grid.Column="2"
                               Text="Preço"
                               FontAttributes="Bold" />

                        <Label Grid.Column="3"
                               Text="Qnt"
                               FontAttributes="Bold" />

                        <Label Grid.Column="4"
                               Text="Total"
                               FontAttributes="Bold" />

                    </Grid>

                </ListView.Header>

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <ViewCell>

                            <ViewCell.ContextActions>
                                <MenuItem Text="Remover"
                                          Clicked="MenuItem_Clicked" />
                            </ViewCell.ContextActions>

                            <Frame CornerRadius="12"
                                   Padding="10"
                                   Margin="6"
                                   HasShadow="True"
                                   BackgroundColor="{StaticResource Secondary}"
                                   BorderColor="{StaticResource Primary}">

                                <Grid ColumnDefinitions="40,*,120"
                                      RowDefinitions="Auto,Auto">

                                    <Label Grid.Row="0"
                                           Grid.Column="0"
                                           Text="{Binding Id}"
                                           VerticalTextAlignment="Center"
                                           TextColor="{StaticResource Gray600}" />

                                    <Label Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding Descricao}"
                                           Style="{StaticResource TitleLabel}"
                                           VerticalOptions="Center" />

                                    <Label Grid.Row="0"
                                           Grid.Column="2"
                                           Text="{Binding Preco, StringFormat='{}{0:c}'}"
                                           HorizontalOptions="End"
                                           Style="{StaticResource SubtitleLabel}" />

                                    <Label Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Qnt:"
                                           TextColor="{StaticResource Gray600}" />

                                    <Label Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Quantidade}"
                                           Style="{StaticResource SubtitleLabel}" />

                                    <Label Grid.Row="1"
                                           Grid.Column="2"
                                           Text="{Binding Total, StringFormat='Total: {0:c}'}"
                                           HorizontalOptions="End"
                                           Style="{StaticResource SubtitleLabel}" />

                                </Grid>

                            </Frame>

                        </ViewCell>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Frame>

    </StackLayout>

</ContentPage>